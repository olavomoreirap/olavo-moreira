---
import BlogCard from '@/components/BlogCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import { BLOG_CATEGORIES } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'

type Category = (typeof BLOG_CATEGORIES)[number]
type Props = {
  category: Category
  posts: CollectionEntry<'blog'>[]
}

export async function getStaticPaths() {
  const posts = await getAllPosts()

  return BLOG_CATEGORIES.map((category: Category) => ({
    params: { id: category.id },
    props: {
      category,
      posts: posts.filter(
        (post: CollectionEntry<'blog'>) => post.data.category === category.id,
      ),
    },
  }))
}

const { category, posts } = Astro.props as Props
// Java Inicial é uma sequência de estudo: lida do primeiro post para o último
const isSequential = category.id === 'java-inicial'
const sortedPosts = [...posts].sort((a, b) =>
  isSequential
    ? a.data.date.valueOf() - b.data.date.valueOf()
    : b.data.date.valueOf() - a.data.date.valueOf(),
)
const ListTag = isSequential ? 'ol' : 'ul'
---

<Layout>
  <PageHead
    slot="head"
    title={`Trilha: ${category.label}`}
    description={category.description}
  />
  <Breadcrumbs
    items={[
      { href: '/trilhas', label: 'Trilhas', icon: 'lucide:layers' },
      { label: category.label, icon: category.icon },
    ]}
  />

  <header class="page-intro">
    <p class="page-prompt" aria-hidden="true">cd ~/trilhas/{category.id}</p>
    <h1>{category.label}</h1>
    <p>{category.description}</p>
    {
      isSequential && sortedPosts.length > 0 && (
        <p class="text-ink-dim text-sm">Leia na ordem, do primeiro ao último.</p>
      )
    }
  </header>

  {
    sortedPosts.length > 0 ? (
      <ListTag
        class:list={[
          'divide-line flex flex-col divide-y',
          { 'trail-steps': isSequential },
        ]}
      >
        {sortedPosts.map((post) => (
          <li>
            <BlogCard entry={post} headingLevel={2} />
          </li>
        ))}
      </ListTag>
    ) : (
      <div class="trail-empty">
        <p>
          Esta trilha está em preparação. Os primeiros estudos entram em breve.
        </p>
        <a href="/blog" class="btn-ghost">
          Ver posts recentes
        </a>
      </div>
    )
  }
</Layout>

<style>
  /* Numeração dos passos só quando a trilha é uma sequência */
  .trail-steps {
    counter-reset: step;
  }
  .trail-steps > li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    counter-increment: step;
  }
  .trail-steps > li::before {
    content: counter(step, decimal-leading-zero);
    padding-top: 1.25rem;
    color: var(--cyan);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .trail-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-muted);
  }
</style>
