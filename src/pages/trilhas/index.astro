---
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllCategories } from '@/lib/data-utils'
import { formatPostCount } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const categories = await getAllCategories()
---

<Layout>
  <PageHead
    slot="head"
    title="Trilhas"
    description="Trilhas de estudo para acompanhar o progresso por tema."
  />

  <header class="page-intro">
    <p class="page-prompt" aria-hidden="true">ls ~/trilhas</p>
    <h1>Trilhas de estudo</h1>
    <p>
      Cada trilha agrupa os posts de um tema numa sequência pensada para ser
      lida em ordem, do básico ao aplicado.
    </p>
  </header>

  <ul class="trail-grid">
    {
      categories.map((category) => (
        <li>
          <article class="trail-card">
            <Icon
              name={category.icon}
              class="trail-card__icon size-5"
              aria-hidden="true"
            />
            <h2 class="trail-card__title">
              <a href={`/trilhas/${category.id}`} class="trail-card__link">
                {category.label}
              </a>
            </h2>
            <p class="trail-card__desc">{category.description}</p>
            <p class="trail-card__footer">
              <span>{formatPostCount(category.count)}</span>
              <span class="trail-card__cta" aria-hidden="true">
                cd {category.id}
              </span>
            </p>
          </article>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .trail-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .trail-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .trail-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .trail-card:hover,
  .trail-card:has(.trail-card__link:focus-visible) {
    border-color: var(--magenta);
    box-shadow: var(--glow-sm);
  }
  .trail-card:has(.trail-card__link:focus-visible) {
    outline: 2px solid var(--magenta);
    outline-offset: 2px;
  }

  .trail-card__icon {
    color: var(--cyan);
  }

  .trail-card__title {
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .trail-card__link {
    transition: color var(--dur-fast) var(--ease-out);
  }
  .trail-card:hover .trail-card__link {
    color: var(--magenta);
  }
  /* O título cobre o card inteiro como área clicável */
  .trail-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .trail-card__link:focus-visible {
    outline: none;
  }

  .trail-card__desc {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .trail-card__footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }
  .trail-card__cta {
    color: var(--cyan);
  }
  .trail-card__cta::before {
    content: '$ ';
    color: var(--ink-dim);
  }
</style>
