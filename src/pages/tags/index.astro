---
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getSortedTags } from '@/lib/data-utils'
import { formatPostCount } from '@/lib/utils'

const sortedTags = await getSortedTags()
---

<Layout>
  <PageHead
    slot="head"
    title="Tags"
    description="Todos os assuntos do blog, organizados por tag."
  />

  <header class="page-intro">
    <p class="page-prompt" aria-hidden="true">ls ~/blog/tags</p>
    <h1>Tags</h1>
    <p>Todos os assuntos do blog. Escolha uma tag para ver os posts dela.</p>
  </header>

  <ul class="tag-cloud">
    {
      sortedTags.map(({ tag, count }) => (
        <li>
          <a href={`/tags/${tag}`} class="tag-cloud__link">
            #{tag}
            <span class="tag-cloud__count">
              <span aria-hidden="true">{count}</span>
              <span class="sr-only">{formatPostCount(count)}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .tag-cloud__link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink-muted);
    font-size: 0.875rem;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .tag-cloud__link:hover,
  .tag-cloud__link:focus-visible {
    border-color: var(--magenta);
    box-shadow: var(--glow-sm);
    color: var(--ink);
  }

  .tag-cloud__count {
    color: var(--cyan);
    font-size: 0.75rem;
  }
</style>
