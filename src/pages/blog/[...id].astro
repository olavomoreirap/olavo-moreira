---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PostHead from '@/components/PostHead.astro'
import PostNavigation from '@/components/PostNavigation.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import { BLOG_CATEGORIES } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAdjacentPosts, getAllPosts } from '@/lib/data-utils'
import { formatDate, readingTime } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }))
}

const post = Astro.props
const { title, description, date, image, tags, category } = post.data
const { Content, headings } = await render(post)
const { next, prev } = await getAdjacentPosts(post.id)
const categoryMeta = BLOG_CATEGORIES.find(({ id }) => id === category)
---

<Layout isWide>
  <PostHead slot="head" post={post} />

  <!-- ADR-0004: barra de progresso de leitura, só CSS (scroll-driven) -->
  <div class="reading-progress" aria-hidden="true"></div>

  <div class="post-grid">
    <div class="col-start-2">
      <Breadcrumbs
        items={[
          { href: '/blog', label: 'Blog', icon: 'lucide:archive' },
          { label: title, icon: 'lucide:file-text' },
        ]}
      />
    </div>

    <header class="post-header col-start-2">
      <p class="post-header__meta">
        {
          categoryMeta ? (
            <a href={`/trilhas/${categoryMeta.id}`} class="post-header__category">
              {categoryMeta.label}
            </a>
          ) : (
            <span class="post-header__category">{category}</span>
          )
        }
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{readingTime(post.body!)}</span>
      </p>

      <h1>{title}</h1>
      <p class="post-header__lede">{description}</p>

      {
        tags && tags.length > 0 && (
          <ul class="post-header__tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${tag}`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      image && (
        <div class="post-cover col-start-2">
          <Image
            src={image}
            alt=""
            width={1200}
            height={630}
            class="h-full w-full object-cover"
          />
        </div>
      )
    }

    {headings.length > 0 && <TableOfContents headings={headings} />}

    <article class="prose col-start-2">
      <Content />
    </article>

    <PostNavigation prevPost={prev} nextPost={next} />
  </div>

  <button
    type="button"
    class="scroll-top btn-ghost hidden"
    id="scroll-to-top"
    aria-label="Voltar ao topo"
    title="Voltar ao topo"
  >
    <Icon name="lucide:arrow-up" class="size-4" aria-hidden="true" />
  </button>

  <script>
    document.addEventListener('astro:page-load', () => {
      const scrollToTopButton = document.getElementById('scroll-to-top')
      const footer = document.querySelector('footer')

      if (!scrollToTopButton || !footer) return

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

      const handleClick = () => {
        window.scrollTo({
          top: 0,
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        })
      }

      const handleScroll = () => {
        const footerRect = footer.getBoundingClientRect()
        const isFooterVisible = footerRect.top <= window.innerHeight

        scrollToTopButton.classList.toggle(
          'hidden',
          window.scrollY <= 300 || isFooterVisible,
        )
      }

      scrollToTopButton.addEventListener('click', handleClick)
      window.addEventListener('scroll', handleScroll, { passive: true })

      const cleanup = () => {
        scrollToTopButton.removeEventListener('click', handleClick)
        window.removeEventListener('scroll', handleScroll)
        document.removeEventListener('astro:before-swap', cleanup)
      }

      document.addEventListener('astro:before-swap', cleanup)
    })
  </script>
</Layout>

<style>
  .reading-progress {
    display: none;
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 3px;
    background: linear-gradient(to right, var(--magenta), var(--cyan));
    box-shadow: 0 0 10px color-mix(in oklab, var(--magenta) 70%, transparent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }
  /* Sem suporte a scroll-driven animations, a barra simplesmente não aparece */
  @supports (animation-timeline: scroll()) {
    .reading-progress {
      display: block;
      animation: reading-progress linear both;
      animation-timeline: scroll(root block);
    }
  }
  /* Barra presa ao scroll também é movimento: some com reduced-motion (ADR-0009) */
  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }
  @keyframes reading-progress {
    to {
      transform: scaleX(1);
    }
  }

  .post-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      min(46rem, 100%)
      minmax(0, 1fr);
    row-gap: 2rem;
  }

  .post-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--ink-dim);
    font-size: 0.875rem;
  }
  .post-header__category {
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .post-header__category::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    background: var(--magenta);
    vertical-align: 0.05em;
  }
  a.post-header__category:hover {
    color: var(--magenta);
  }

  .post-header h1 {
    margin-top: 1rem;
    color: var(--ink);
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.12;
    text-wrap: balance;
    text-shadow:
      -1px 0 color-mix(in oklab, var(--cyan) 45%, transparent),
      1px 0 color-mix(in oklab, var(--magenta) 45%, transparent);
  }
  .post-header__lede {
    max-width: 60ch;
    margin-top: 1rem;
    color: var(--ink-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .post-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
  }
  .post-header__tags a {
    color: var(--ink-dim);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .post-header__tags a:hover {
    color: var(--magenta);
  }

  .post-cover {
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--void);
  }

  .scroll-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 50;
    justify-content: center;
    width: 2.75rem;
    padding: 0;
    background: var(--void);
  }
</style>
