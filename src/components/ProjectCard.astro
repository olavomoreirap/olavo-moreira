---
import Link from '@/components/Link.astro'
import { Badge } from '@/components/ui/badge'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { featured, image, name, description, startDate, endDate, tags, link } =
  project.data
const projectHref = `/projects/${project.id}`
---

<article
  class:list={['project-card', featured && 'project-card--featured']}
>
  {
    image && (
      <Link
        href={projectHref}
        class="project-card__media"
        tabindex="-1"
        aria-hidden="true"
      >
        <Image
          src={image}
          alt=""
          width={1200}
          height={630}
          class="h-full w-full object-cover"
        />
      </Link>
    )
  }
  <div class="flex grow flex-col gap-3 p-5">
    <h3 class="text-ink text-lg font-medium">
      <Link href={projectHref} class="project-card__title">{name}</Link>
    </h3>
    <p class="text-ink-muted line-clamp-3 text-sm leading-relaxed">
      {description}
    </p>
    {
      startDate && (
        <p class="text-ink-dim flex items-center gap-1.5 text-xs">
          <Icon name="lucide:calendar" class="size-3" aria-hidden="true" />
          {formatDate(startDate)} até{' '}
          {endDate ? formatDate(endDate) : 'hoje'}
        </p>
      )
    }
    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5" aria-label="Tecnologias e temas">
          {tags.map((tag: string) => (
            <li>
              <Badge variant="secondary" className="max-w-full whitespace-normal">
                {tag}
              </Badge>
            </li>
          ))}
        </ul>
      )
    }
    <div class="mt-auto flex flex-wrap gap-4 pt-2 text-sm">
      <Link href={projectHref} class="text-magenta" underline>
        Ler sobre o projeto
      </Link>
      <Link href={link} external class="text-ink-muted" underline>
        Abrir projeto
        <span class="sr-only">(abre em nova aba)</span>
      </Link>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .project-card--featured {
    border-color: color-mix(in oklab, var(--magenta) 35%, var(--line));
  }
  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--magenta);
    box-shadow: var(--glow-sm);
  }

  .project-card__media {
    aspect-ratio: 1200 / 630;
    border-bottom: 1px solid var(--line);
    background: var(--void);
    overflow: hidden;
  }
  .project-card__media :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .project-card:hover .project-card__media :global(img) {
    transform: scale(1.03);
  }

  /* O título cobre o card inteiro como área clicável */
  .project-card__title::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .project-card__title:focus-visible {
    outline: none;
  }
  .project-card:has(.project-card__title:focus-visible) {
    outline: 2px solid var(--magenta);
    outline-offset: 3px;
  }
  /* Links secundários ficam acima da área clicável do título */
  .project-card :global(a:not(.project-card__title)) {
    position: relative;
    z-index: 1;
  }
</style>
