---
import Link from '@/components/Link.astro'
import MobileMenu from '@/components/ui/mobile-menu'
import { NAV_LINKS, SITE } from '@/consts'
import { cn } from '@/lib/utils'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'

const { isWide = false } = Astro.props
const currentPath = Astro.url.pathname

const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`)
---

<header
  class="border-line/60 bg-void/80 sticky top-0 z-20 border-b backdrop-blur-md"
>
  <div
    class={cn(
      'mx-auto flex items-center justify-between gap-4 px-4 py-3',
      isWide ? 'max-w-6xl' : 'max-w-3xl',
    )}
  >
    <Link href="/" class="site-logo group flex shrink-0 items-center gap-2.5">
      <Image src={logo} alt="" class="size-7" />
      <span class="text-ink font-medium">{SITE.title}</span>
    </Link>

    <div class="flex items-center gap-2 md:gap-6">
      <nav aria-label="Principal" class="hidden items-center gap-6 md:flex">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="nav-link text-sm"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <a href="/#contato" class="btn-ghost nav-cta text-sm">contato</a>
      <MobileMenu client:media="(max-width: 768px)" />
    </div>
  </div>
</header>

<style>
  .site-logo img {
    transition: filter var(--dur-base) var(--ease-out);
  }
  .site-logo:hover img,
  .site-logo:focus-visible img {
    filter: drop-shadow(0 0 8px color-mix(in oklab, var(--magenta) 60%, transparent));
  }

  .nav-link {
    position: relative;
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-link[aria-current='page'] {
    color: var(--magenta);
  }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.4rem;
    height: 1px;
    background: var(--magenta);
    box-shadow: 0 0 8px var(--magenta);
  }

  .nav-cta {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border-color: color-mix(in oklab, var(--magenta) 55%, var(--line));
  }
</style>
