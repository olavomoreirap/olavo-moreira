---
import { SITE, SOCIAL_LINKS } from '@/consts'
import { cn } from '@/lib/utils'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'

const { isWide = false } = Astro.props
---

<footer class="border-line/60 border-t py-6">
  <div
    class={cn(
      'text-ink-dim mx-auto flex flex-col items-center gap-4 px-4 text-sm sm:flex-row sm:justify-between',
      isWide ? 'max-w-6xl' : 'max-w-3xl',
    )}
  >
    <p class="text-center sm:text-left">
      &copy; {new Date().getFullYear()}
      {SITE.author}. Feito com Astro sobre o tema <Link
        href="https://github.com/jktrn/astro-erudite"
        external
        underline>astro-erudite</Link
      >.
    </p>
    <SocialIcons links={SOCIAL_LINKS} />
  </div>
</footer>
