---
import type { MarkdownHeading } from 'astro'
import { Icon } from 'astro-icon/components'

type Props = {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const minDepth = Math.min(...headings.map(({ depth }) => depth))
---

<details
  open
  class="toc group col-start-2 xl:sticky xl:top-20 xl:col-start-1 xl:mr-10 xl:ml-auto xl:h-[calc(100vh-6rem)] xl:w-56"
>
  <summary class="toc__summary">
    <span>Sumário</span>
    <Icon
      name="lucide:chevron-down"
      class="size-4 shrink-0 transition-transform group-open:rotate-180"
      aria-hidden="true"
    />
  </summary>

  <nav aria-label="Sumário" class="toc__nav">
    <p class="toc__heading hidden xl:block" aria-hidden="true">Sumário</p>
    <ul id="table-of-contents" class="toc__list">
      {
        headings.map((heading) => (
          <li style={`--depth: ${heading.depth - minDepth}`}>
            <a href={`#${heading.slug}`} class="toc__link">
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>

<script>
  function setupToc() {
    const header = document.querySelector('header')
    const headerHeight = header ? header.offsetHeight : 0

    const observer = new IntersectionObserver(
      (sections) => {
        sections.forEach((section) => {
          const heading = section.target.querySelector('h2, h3, h4, h5, h6')
          if (!heading) return

          const id = heading.getAttribute('id')
          const link = document.querySelector(
            `#table-of-contents a[href="#${id}"]`,
          )
          link?.classList.toggle('is-active', section.isIntersecting)
        })
      },
      {
        rootMargin: `-${headerHeight}px 0px 0px 0px`,
      },
    )

    document.querySelectorAll('.prose section').forEach((section) => {
      observer.observe(section)
    })
  }

  // No xl o sumário é coluna fixa e o <summary> some: se o usuário fechou no
  // mobile e alargou a janela, reabre para não sumir com a navegação inteira
  const xlQuery = window.matchMedia('(min-width: 1280px)')
  function keepTocOpenOnXl() {
    const toc = document.querySelector<HTMLDetailsElement>('details.toc')
    if (toc && xlQuery.matches) toc.open = true
  }
  xlQuery.addEventListener('change', keepTocOpenOnXl)
  document.addEventListener('astro:page-load', keepTocOpenOnXl)

  document.addEventListener('astro:page-load', setupToc)
</script>

<style>
  .toc {
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  @media (min-width: 1280px) {
    .toc {
      padding: 0;
      border: 0;
      background: none;
    }
  }

  .toc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ink);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .toc__summary::-webkit-details-marker {
    display: none;
  }
  .toc[open] .toc__summary {
    padding-bottom: 0.75rem;
  }
  /* No xl o sumário vira coluna lateral fixa: sem botão de abrir/fechar */
  @media (min-width: 1280px) {
    .toc__summary {
      display: none;
    }
  }

  .toc__nav {
    max-height: 16rem;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  @media (min-width: 1280px) {
    .toc__nav {
      max-height: 100%;
    }
  }

  .toc__heading {
    margin-bottom: 0.75rem;
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }

  .toc__list {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }
  .toc__list li {
    padding-left: calc(var(--depth, 0) * 0.875rem);
  }

  .toc__link {
    display: block;
    margin-left: -1px;
    padding: 0.3rem 0 0.3rem 0.875rem;
    border-left: 2px solid transparent;
    color: var(--ink-dim);
    font-size: 0.8125rem;
    line-height: 1.45;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .toc__link:hover {
    color: var(--ink);
  }
  .toc__link.is-active {
    border-left-color: var(--magenta);
    color: var(--ink);
  }
</style>
