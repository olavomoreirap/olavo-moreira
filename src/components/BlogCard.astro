---
import { BLOG_CATEGORIES } from '@/consts'
import { formatDate, readingTime } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'blog'>
  /** Nível do título: 2 quando a lista fica logo abaixo do h1 da página */
  headingLevel?: 2 | 3
}

const { entry, headingLevel = 3 } = Astro.props
const Heading = `h${headingLevel}` as const
const { title, description, date, image, tags, category } = entry.data
const postHref = `/${entry.collection}/${entry.id}`
const categoryLabel =
  BLOG_CATEGORIES.find(({ id }) => id === category)?.label ?? category
---

<article class="post-row">
  {
    image && (
      <div class="post-row__media" aria-hidden="true">
        <Image
          src={image}
          alt=""
          width={352}
          height={185}
          class="h-full w-full object-cover"
        />
      </div>
    )
  }

  <div class="post-row__body">
    <p class="post-row__meta">
      <span class="post-row__category">{categoryLabel}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span>{readingTime(entry.body!)}</span>
    </p>

    <Heading class="post-row__title">
      <a href={postHref} class="post-row__link">{title}</a>
    </Heading>

    <p class="post-row__desc">{description}</p>

    {
      tags && tags.length > 0 && (
        <ul class="post-row__tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>#{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .post-row {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1rem;
    border-left: 2px solid transparent;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  @media (min-width: 640px) {
    .post-row {
      grid-template-columns: 11rem 1fr;
      gap: 1.5rem;
      align-items: start;
    }
  }
  .post-row:hover,
  .post-row:has(.post-row__link:focus-visible) {
    border-left-color: var(--magenta);
    background: color-mix(in oklab, var(--surface) 70%, transparent);
  }

  .post-row__media {
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--void);
  }
  .post-row__media :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .post-row:hover .post-row__media :global(img) {
    transform: scale(1.04);
  }

  .post-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }
  .post-row__category {
    color: var(--ink-muted);
  }
  .post-row__category::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    background: var(--magenta);
    vertical-align: 0.05em;
  }

  .post-row__title {
    margin-top: 0.5rem;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }
  .post-row__link {
    transition: color var(--dur-fast) var(--ease-out);
  }
  .post-row:hover .post-row__link {
    color: var(--magenta);
  }
  /* O título cobre a linha inteira como área clicável */
  .post-row__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-row__link:focus-visible {
    outline: none;
  }
  .post-row:has(.post-row__link:focus-visible) {
    outline: 2px solid var(--magenta);
    outline-offset: 2px;
  }

  .post-row__desc {
    max-width: 65ch;
    margin-top: 0.375rem;
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin-top: 0.75rem;
    color: var(--ink-dim);
    font-size: 0.75rem;
  }
</style>
